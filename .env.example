# =============================================================================
# 衛福部藥品仿單智慧查詢系統 - 環境變數範本 (.env.example)
# =============================================================================

# 1. Google Cloud Firestore 自動存檔設定（擇一即可）
# -----------------------------------------------------------------------------
# 方式 A（最推薦 Render.com 雲端代管）：直接貼上 Firebase 服務帳戶 JSON 全文
# 請在 Render.com Dashboard -> Environment 新增此變數：
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com",...}

# 方式 B（本機開發測試）：指向下載的 JSON 金鑰檔案路徑
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# 2. 自訂 Firestore Collection 集合名稱（預設為 drug_queries）
# -----------------------------------------------------------------------------
FIRESTORE_COLLECTION=drug_queries

# 3. 伺服器連接埠設定（本機預設 5050，Render 雲端會自動注入 PORT 變數）
# -----------------------------------------------------------------------------
PORT=5050
