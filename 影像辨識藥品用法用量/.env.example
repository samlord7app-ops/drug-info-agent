# =============================================================================
# 影像辨識藥品用法用量系統 - 環境變數設定範本 (.env.example)
# 請複製此檔案並重新命名為 .env，填入您的 API Key（亦可在網頁介面右上角直接設定）
# =============================================================================

# 1. Google Gemini API Key (推薦使用 gemini-2.5-flash)
GEMINI_API_KEY=

# 2. OpenAI API Key (選填，若使用 gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=

# 3. 服務埠號 (預設 5080)
PORT=5080
